@prefix gtfs: <http://vocab.gtfs.org/terms#> .
@prefix lt: <http://example.org/london-transport#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

lt:ActiveService a owl:Class ;
    rdfs:label "Active Service" ;
    rdfs:comment "A service referenced by trips that are assigned to routes" ;
    rdfs:subClassOf gtfs:Service ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty lt:belongsToService ;
                        owl:someValuesFrom gtfs:Service ] [ a owl:Restriction ;
                        owl:onProperty lt:onRoute ;
                        owl:someValuesFrom gtfs:Route ] ) ] .

lt:BusStop a owl:Class ;
    rdfs:label "Bus Stop" ;
    rdfs:comment "A stop specifically for bus services" ;
    rdfs:subClassOf gtfs:Stop .

lt:FullyOperationalRoute a owl:Class ;
    rdfs:label "Fully Operational Route" ;
    rdfs:comment "A route operated by an operator and serving at least one stop" ;
    rdfs:subClassOf gtfs:Route ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty lt:operatedBy ;
                        owl:someValuesFrom lt:TransportOperator ] [ a owl:Restriction ;
                        owl:onProperty lt:hasStop ;
                        owl:someValuesFrom gtfs:Stop ] ) ] .

lt:RouteWithStopsAndTrips a owl:Class ;
    rdfs:label "Route With Stops And Trips" ;
    rdfs:comment "A route with at least one trip and one stop" ;
    rdfs:subClassOf gtfs:Route ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty lt:hasTrip ;
                        owl:someValuesFrom gtfs:Trip ] [ a owl:Restriction ;
                        owl:onProperty lt:hasStop ;
                        owl:someValuesFrom gtfs:Stop ] ) ] .

lt:Statistic a owl:Class ;
    rdfs:label "Statistic" ;
    rdfs:comment "Quantitative data regarding ridership, performance, or usage" ;
    rdfs:subClassOf lt:TransportEntity .

lt:TrainRoute a owl:Class ;
    rdfs:label "Train Route" ;
    rdfs:comment "A route used by trains" ;
    rdfs:subClassOf gtfs:Route .

lt:WellConnectedRoute a owl:Class ;
    rdfs:label "Well Connected Route" ;
    rdfs:comment "A route whose stops are connected to other stops" ;
    rdfs:subClassOf gtfs:Route ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty lt:hasStop ;
                        owl:someValuesFrom gtfs:Stop ] [ a owl:Restriction ;
                        owl:onProperty lt:connectsTo ;
                        owl:someValuesFrom gtfs:Stop ] ) ] .

lt:aboutLine a owl:ObjectProperty ;
    rdfs:label "about line" ;
    rdfs:comment "Links a report to the transport line it concerns" ;
    rdfs:domain lt:Report ;
    rdfs:range lt:TransportLine ;
    rdfs:subPropertyOf lt:relatedTo ;
    owl:inverseOf lt:isAboutLine .

lt:busRouteNumber a owl:DatatypeProperty ;
    rdfs:label "Bus route number/name" ;
    rdfs:comment "The specific identifier or number used to distinguish a London bus route" ;
    rdfs:domain lt:BusRoute ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf gtfs:routeShortName .

lt:description a owl:DatatypeProperty ;
    rdfs:label "description" ;
    rdfs:comment "A textual explanation providing additional details" ;
    rdfs:subPropertyOf lt:value .

lt:disruptionReason a owl:DatatypeProperty ;
    rdfs:label "disruption reason" ;
    rdfs:comment "The explanation provided for a service disruption" ;
    rdfs:domain lt:TransportLine ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf lt:value .

lt:endDate a owl:DatatypeProperty ;
    rdfs:label "end date" ;
    rdfs:comment "The date on which a service ceases operation" ;
    rdfs:domain gtfs:Service ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf lt:value .

lt:extendsTo a owl:DatatypeProperty ;
    rdfs:label "extends to" ;
    rdfs:comment "The geographic reach or terminal destination of a service" ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf lt:value .

lt:hasFrequency a owl:DatatypeProperty ;
    rdfs:label "has frequency" ;
    rdfs:comment "Information about how often a service runs" ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf lt:value .

lt:hasNightService a owl:DatatypeProperty ;
    rdfs:label "has night service" ;
    rdfs:comment "A flag indicating if a line operates during night hours" ;
    rdfs:domain lt:TransportLine ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf lt:value .

lt:hasRidership a owl:DatatypeProperty ;
    rdfs:label "has ridership" ;
    rdfs:comment "Data regarding the number of passengers using a service" ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf lt:value .

lt:hasRoute a owl:ObjectProperty ;
    rdfs:label "has route" ;
    rdfs:comment "A transport line contains routes" ;
    rdfs:domain lt:TransportLine ;
    rdfs:range gtfs:Route ;
    rdfs:subPropertyOf lt:relatedTo .

lt:hasStatus a owl:DatatypeProperty ;
    rdfs:label "has status" ;
    rdfs:comment "The current operational status of a transport line" ;
    rdfs:domain lt:TransportLine ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf lt:value .

lt:hasStopName a owl:DatatypeProperty ;
    rdfs:label "has stop name" ;
    rdfs:comment "The textual name of a stop from a transport API" ;
    rdfs:domain lt:TransportLine ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf lt:value .

lt:intersectsWith a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "intersects with" ;
    rdfs:comment "Identifies transport lines that share a common station location" ;
    rdfs:domain lt:TransportLine ;
    rdfs:range lt:TransportLine ;
    rdfs:subPropertyOf lt:relatedTo .

lt:isDisrupted a owl:DatatypeProperty ;
    rdfs:label "is disrupted" ;
    rdfs:comment "A flag indicating if a line is currently experiencing delays" ;
    rdfs:domain lt:TransportLine ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf lt:value .

lt:lineName a owl:DatatypeProperty ;
    rdfs:label "Transport line name" ;
    rdfs:comment "The specific name of a transport service line" ;
    rdfs:domain lt:TransportLine ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf schema:name .

lt:line_island-line a lt:NationalRailLine ;
    rdfs:label "Island Line" ;
    lt:extendsTo "Ryde Pier Head Rail Station",
        "Shanklin Rail Station" ;
    lt:hasNightService false ;
    lt:hasStatus "Good Service" ;
    lt:hasStopName "Brading Rail Station",
        "Lake (Isle of Wight) Rail Station",
        "Ryde Esplanade Rail Station",
        "Ryde Pier Head Ferry Terminal",
        "Ryde Pier Head Rail Station",
        "Ryde St Johns Road Rail Station",
        "Sandown Rail Station",
        "Shanklin Rail Station",
        "Smallbrook Junction Rail Station" ;
    lt:isDisrupted false ;
    lt:lineName "Island Line" .

lt:line_london-cable-car a lt:TransportLine ;
    rdfs:label "IFS Cloud Cable Car" ;
    lt:extendsTo "IFS Cloud Greenwich Peninsula",
        "IFS Cloud Royal Docks" ;
    lt:hasNightService false ;
    lt:hasStatus "Good Service" ;
    lt:hasStopName "IFS Cloud Greenwich Peninsula",
        "IFS Cloud Royal Docks" ;
    lt:isDisrupted false ;
    lt:lineName "IFS Cloud Cable Car" .

lt:line_scs a lt:BusLine ;
    rdfs:label "SCS" ;
    lt:disruptionReason "PAVILION LANE (SE10/North Greenwich) - From midnight 07 April until 12 April, ROUTES 129 towards Gallions Reach & SCS buses travelling to Royals Docks are following a short diversion via Millenium Way, Blackwall Lane and Silvertown Tunnel due to Riverlinx carriageway works. Buses will continue to serve all stops as normal but please allow extra time for your journey, as slight delays may be experienced en route." ;
    lt:extendsTo "Millennium Way",
        "Seagull Lane" ;
    lt:hasNightService false ;
    lt:hasStatus "Bus Service" ;
    lt:hasStopName "Millennium Way",
        "Seagull Lane" ;
    lt:isDisrupted true ;
    lt:lineName "SCS" .

lt:line_woolwich-ferry a lt:RiverBusLine ;
    rdfs:label "Woolwich Ferry" ;
    lt:disruptionReason "WOOLWICH FERRY: From Monday 9 March until mid April, a reduced one boat service operates due to essential vessel maintenance. During this time, the last crossing from the South Terminal will depart at 2140, and at 2200 from the North Terminal." ;
    lt:extendsTo "Woolwich Ferry North Pier",
        "Woolwich Ferry South Pier" ;
    lt:hasNightService false ;
    lt:hasStatus "Reduced Service" ;
    lt:hasStopName "Woolwich Ferry North Pier",
        "Woolwich Ferry South Pier" ;
    lt:isDisrupted true ;
    lt:lineName "Woolwich Ferry" .

lt:locatedIn a owl:ObjectProperty ;
    rdfs:label "located in" ;
    rdfs:comment "Specifies the geographic or administrative container of a place" ;
    rdfs:domain gtfs:Stop ;
    rdfs:range gtfs:Stop ;
    rdfs:subPropertyOf lt:relatedTo .

lt:mentionedInReport a owl:ObjectProperty ;
    rdfs:label "mentioned in report" ;
    rdfs:comment "Links a transport entity to a report discussing its status" ;
    rdfs:subPropertyOf lt:relatedTo .

lt:name a owl:DatatypeProperty ;
    rdfs:label "name" ;
    rdfs:comment "The name of a place or organisation" ;
    rdfs:subPropertyOf lt:value .

lt:naptanCode a owl:DatatypeProperty ;
    rdfs:label "NaPTAN stop code" ;
    rdfs:comment "A unique identifier assigned to a stop within the UK NaPTAN system" ;
    rdfs:domain gtfs:Stop ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf gtfs:stopName .

lt:onTrip a owl:ObjectProperty ;
    rdfs:label "on trip" ;
    rdfs:comment "A stop time is part of a trip" ;
    rdfs:domain gtfs:StopTime ;
    rdfs:range gtfs:Trip ;
    rdfs:subPropertyOf lt:relatedTo .

lt:operatorName a owl:DatatypeProperty ;
    rdfs:label "Operator trading name" ;
    rdfs:comment "The trading name of a transport operator" ;
    rdfs:domain lt:TransportOperator ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf schema:name .

lt:routeNumber a owl:DatatypeProperty ;
    rdfs:label "route number" ;
    rdfs:comment "The identifier or number used to distinguish a bus route" ;
    rdfs:domain gtfs:Route ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf lt:value .

lt:servedBy a owl:ObjectProperty ;
    rdfs:label "served by" ;
    rdfs:comment "Indicates the transport service that provides access to a location" ;
    rdfs:subPropertyOf lt:relatedTo .

lt:servesStation a owl:ObjectProperty ;
    rdfs:label "serves station" ;
    rdfs:comment "Identifies a station served by a particular route or line" ;
    rdfs:domain gtfs:Route ;
    rdfs:range lt:TrainStation ;
    rdfs:subPropertyOf lt:relatedTo ;
    owl:inverseOf lt:isServedBy .

lt:startDate a owl:DatatypeProperty ;
    rdfs:label "start date" ;
    rdfs:comment "The date on which a service begins operation" ;
    rdfs:domain gtfs:Service ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf lt:value .

lt:stopCode a owl:DatatypeProperty ;
    rdfs:label "stop code" ;
    rdfs:comment "A unique identifier assigned to a stop within the UK NaPTAN system" ;
    rdfs:domain gtfs:Stop ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf lt:value .

lt:stopsAt a owl:ObjectProperty ;
    rdfs:label "stops at" ;
    rdfs:comment "A stop time occurs at a specific stop" ;
    rdfs:domain gtfs:StopTime ;
    rdfs:range gtfs:Stop ;
    rdfs:subPropertyOf lt:relatedTo .

lt:wheelchairAccessible a owl:DatatypeProperty ;
    rdfs:label "wheelchair accessible" ;
    rdfs:comment "Indicates whether a stop is accessible to wheelchair users" ;
    rdfs:domain gtfs:Stop ;
    rdfs:range xsd:boolean ;
    rdfs:subPropertyOf lt:value .

gtfs:arrivalTime a owl:DatatypeProperty ;
    rdfs:label "Arrival Time" ;
    rdfs:comment "The scheduled arrival time at a specific stop" ;
    rdfs:range xsd:string .

gtfs:departureTime a owl:DatatypeProperty ;
    rdfs:label "Departure Time" ;
    rdfs:comment "The scheduled departure time from a specific stop" ;
    rdfs:range xsd:string .

gtfs:headsign a owl:DatatypeProperty ;
    rdfs:label "Headsign" ;
    rdfs:comment "The destination text displayed to passengers on a vehicle" ;
    rdfs:range xsd:string .

gtfs:lat a owl:DatatypeProperty ;
    rdfs:label "Latitude" ;
    rdfs:comment "The latitude coordinate of a stop" ;
    rdfs:range xsd:float .

gtfs:long a owl:DatatypeProperty ;
    rdfs:label "Longitude" ;
    rdfs:comment "The longitude coordinate of a stop" ;
    rdfs:range xsd:float .

schema:url a owl:DatatypeProperty ;
    rdfs:label "URL" ;
    rdfs:comment "URL" ;
    rdfs:range xsd:string .

lt:BusRoute a owl:Class ;
    rdfs:label "Bus Route" ;
    rdfs:comment "A route used by buses" ;
    rdfs:subClassOf gtfs:Route .

lt:DLRLine a owl:Class ;
    rdfs:label "DLR Line" ;
    rdfs:comment "A transport line operating within the Docklands Light Railway system" ;
    rdfs:subClassOf lt:TransportLine .

lt:ElizabethLine a owl:Class ;
    rdfs:label "Elizabeth Line" ;
    rdfs:comment "A high-capacity railway line running across London and surrounding areas" ;
    rdfs:subClassOf lt:TransportLine .

lt:TramLine a owl:Class ;
    rdfs:label "Tram Line" ;
    rdfs:comment "A transport line operated by trams" ;
    rdfs:subClassOf lt:TransportLine .

lt:belongsToService a owl:ObjectProperty ;
    rdfs:label "belongs to service" ;
    rdfs:comment "A trip is associated with a service schedule" ;
    rdfs:domain gtfs:Trip ;
    rdfs:range gtfs:Service ;
    rdfs:subPropertyOf lt:relatedTo .

lt:connectsTo a owl:ObjectProperty ;
    rdfs:label "connects to" ;
    rdfs:comment "A stop is connected to another stop" ;
    rdfs:domain gtfs:Stop ;
    rdfs:range gtfs:Stop ;
    rdfs:subPropertyOf lt:relatedTo .

lt:isAboutLine a owl:ObjectProperty ;
    rdfs:label "is about line" ;
    rdfs:comment "Inverse of aboutLine linking a transport line to reports about it" ;
    rdfs:domain lt:TransportLine ;
    rdfs:range lt:Report ;
    rdfs:subPropertyOf lt:relatedTo .

lt:isServedBy a owl:ObjectProperty ;
    rdfs:label "is served by" ;
    rdfs:comment "Inverse property linking a station to its calling routes" ;
    rdfs:domain lt:TrainStation ;
    rdfs:range gtfs:Route ;
    rdfs:subPropertyOf lt:relatedTo .

lt:isStopOn a owl:ObjectProperty ;
    rdfs:label "is stop on" ;
    rdfs:comment "Inverse property linking a stop to the routes it serves" ;
    rdfs:domain gtfs:Stop ;
    rdfs:range gtfs:Route ;
    rdfs:subPropertyOf lt:relatedTo .

lt:onRoute a owl:ObjectProperty ;
    rdfs:label "on route" ;
    rdfs:comment "A trip is part of a route" ;
    rdfs:domain gtfs:Trip ;
    rdfs:range gtfs:Route ;
    rdfs:subPropertyOf lt:relatedTo ;
    owl:inverseOf lt:hasTrip .

lt:operatedBy a owl:ObjectProperty ;
    rdfs:label "operated by" ;
    rdfs:comment "A route is operated by a transport operator" ;
    rdfs:domain gtfs:Route ;
    rdfs:range lt:TransportOperator ;
    rdfs:subPropertyOf lt:relatedTo .

gtfs:routeShortName a owl:DatatypeProperty ;
    rdfs:label "Route Short Name" ;
    rdfs:comment "The short name or number of a transit route" ;
    rdfs:range xsd:string .

gtfs:stopName a owl:DatatypeProperty ;
    rdfs:label "Stop Name" ;
    rdfs:comment "The name of a stop" ;
    rdfs:range xsd:string .

schema:Organization a owl:Class ;
    rdfs:label "schema:Organization" ;
    rdfs:comment "Schema.org Organization" .

schema:Place a owl:Class ;
    rdfs:label "schema:Place" ;
    rdfs:comment "Schema.org Place" .

lt:Report a owl:Class ;
    rdfs:label "Report" ;
    rdfs:comment "A service update, incident report, or status announcement" ;
    rdfs:subClassOf lt:TransportEntity .

lt:TrainStation a owl:Class ;
    rdfs:label "Train Station" ;
    rdfs:comment "A station for train services" ;
    rdfs:subClassOf gtfs:Stop .

lt:hasTrip a owl:ObjectProperty ;
    rdfs:label "has trip" ;
    rdfs:comment "Links a route to the journeys scheduled upon it" ;
    rdfs:domain gtfs:Route ;
    rdfs:range gtfs:Trip ;
    rdfs:subPropertyOf lt:relatedTo .

lt:line_heathrow-express a lt:NationalRailLine ;
    rdfs:label "Heathrow Express" ;
    lt:extendsTo "Heathrow Terminal 5 Rail Station",
        "London Paddington Rail Station" ;
    lt:hasNightService false ;
    lt:hasStatus "Good Service" ;
    lt:hasStopName "Heathrow Terminal 5 Rail Station",
        "Heathrow Terminals 2 & 3 Rail Station",
        "London Paddington Rail Station" ;
    lt:intersectsWith lt:line_elizabeth,
        lt:line_great-western-railway ;
    lt:isDisrupted false ;
    lt:lineName "Heathrow Express" .

lt:line_suffragette a lt:OvergroundLine ;
    rdfs:label "Suffragette" ;
    lt:extendsTo "Barking Riverside",
        "Gospel Oak Rail Station" ;
    lt:hasNightService false ;
    lt:hasStatus "Good Service" ;
    lt:hasStopName "Barking Rail Station",
        "Barking Riverside",
        "Blackhorse Road Rail Station",
        "Crouch Hill Rail Station",
        "Gospel Oak Rail Station",
        "Harringay Green Lanes Rail Station",
        "Leyton Midland Road Rail Station",
