@prefix gtfs: <http://vocab.gtfs.org/terms#> .
@prefix lt: <http://example.org/london-transport#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema1: <http://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

lt:BusLine a owl:Class ;
    rdfs:label "Bus Line" ;
    rdfs:subClassOf lt:TransportLine .

lt:BusStop a owl:Class ;
    rdfs:label "Bus Stop" ;
    rdfs:subClassOf gtfs:Stop .

lt:TrainRoute a owl:Class ;
    rdfs:label "Train Route" ;
    rdfs:subClassOf gtfs:Route .

lt:TrainStation a owl:Class ;
    rdfs:label "Train Station" ;
    rdfs:subClassOf gtfs:Stop .

lt:belongsToService a owl:ObjectProperty ;
    rdfs:label "belongs to service" ;
    rdfs:domain gtfs:Trip ;
    rdfs:range gtfs:Service .

lt:busRouteNumber a owl:DatatypeProperty ;
    rdfs:label "Bus route number/name" ;
    rdfs:domain lt:BusRoute ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf gtfs:routeShortName .

lt:hasRoute a owl:ObjectProperty ;
    rdfs:label "has route" ;
    rdfs:domain lt:TransportLine ;
    rdfs:range gtfs:Route .

lt:hasStop a owl:ObjectProperty ;
    rdfs:label "has stop" ;
    rdfs:domain gtfs:Route ;
    rdfs:range gtfs:Stop .

lt:lineName a owl:DatatypeProperty ;
    rdfs:label "Transport line name" ;
    rdfs:domain lt:TransportLine ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf schema1:name .

