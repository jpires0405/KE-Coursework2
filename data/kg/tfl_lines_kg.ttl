    lt:intersectsWith lt:line_c2c,
        lt:line_mildmay ;
    lt:isDisrupted false ;
    lt:lineName "Suffragette" .

gtfs:StopTime a owl:Class ;
    rdfs:label "gtfs:Stop Time" ;
    rdfs:comment "Arrival and departure times at a stop for a trip" .

schema:name a owl:DatatypeProperty ;
    rdfs:label "Name" ;
    rdfs:comment "The name" ;
    rdfs:range xsd:string .

lt:TransportEntity a owl:Class ;
    rdfs:label "Transport Entity" ;
    rdfs:comment "The root class for all London transport-related concepts." .

lt:TransportOperator a owl:Class ;
    rdfs:label "Transport Operator" ;
    rdfs:comment "An organisation responsible for operating transport services" ;
    rdfs:subClassOf schema:Organization .

lt:hasStop a owl:ObjectProperty ;
    rdfs:label "has stop" ;
    rdfs:comment "A route goes through specific stops" ;
    rdfs:domain gtfs:Route ;
    rdfs:range gtfs:Stop ;
    rdfs:subPropertyOf lt:relatedTo ;
    owl:inverseOf lt:isStopOn .

lt:line_liberty a lt:OvergroundLine ;
    rdfs:label "Liberty" ;
    lt:extendsTo "Romford Rail Station",
        "Upminster Rail Station" ;
    lt:hasNightService false ;
    lt:hasStatus "Good Service" ;
    lt:hasStopName "Emerson Park Rail Station",
        "Romford Rail Station",
        "Upminster Rail Station" ;
    lt:intersectsWith lt:line_c2c,
        lt:line_elizabeth,
        lt:line_greater-anglia ;
    lt:isDisrupted false ;
    lt:lineName "Liberty" .

