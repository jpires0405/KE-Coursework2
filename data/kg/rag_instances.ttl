    lt:lineColour "#00B5A9" ;
    lt:modeOfTransport lt:mode_dlr .
lt:line_tram a lt:TramLine ;
    lt:lineColour "#FFA07A" ;
    lt:modeOfTransport lt:mode_tram .
lt:line_rb1 a lt:RiverBusLine ;
    lt:lineColour "#0097A7" ;
    lt:modeOfTransport lt:mode_river_bus .
lt:line_rb2 a lt:RiverBusLine ;
    lt:lineColour "#0097A7" ;
    lt:modeOfTransport lt:mode_river_bus .
lt:line_rb4 a lt:RiverBusLine ;
    lt:lineColour "#0097A7" ;
    lt:modeOfTransport lt:mode_river_bus .
lt:line_rb6 a lt:RiverBusLine ;
    lt:lineColour "#0097A7" ;
    lt:modeOfTransport lt:mode_river_bus .
lt:line_liberty a lt:OvergroundLine ;
    lt:lineColour "#FFC080" ;
    lt:modeOfTransport lt:mode_overground .
lt:line_lioness a lt:OvergroundLine ;
    lt:lineColour "#FFC080" ;
    lt:modeOfTransport lt:mode_overground .
lt:line_mildmay a lt:OvergroundLine ;
    lt:lineColour "#FFC080" ;
    lt:modeOfTransport lt:mode_overground .
lt:line_suffragette a lt:OvergroundLine ;
    lt:lineColour "#FFC080" ;
    lt:modeOfTransport lt:mode_overground .
lt:line_weaver a lt:OvergroundLine ;
    lt:lineColour "#FFC080" ;
    lt:modeOfTransport lt:mode_overground .
lt:line_windrush a lt:OvergroundLine ;
    lt:lineColour "#FFC080" ;
    lt:modeOfTransport lt:mode_overground .

lt:mode_tube a lt:TransportEntity ;
    rdfs:label "Tube" .
lt:mode_dlr a lt:TransportEntity ;
    rdfs:label "DLR" .
lt:mode_tram a lt:TransportEntity ;
    rdfs:label "Tram" .
lt:mode_river_bus a lt:TransportEntity ;
    rdfs:label "River Bus" .
lt:mode_overground a lt:TransportEntity ;
    rdfs:label "Overground" .
lt:mode_elizabeth_line a lt:TransportEntity ;
    rdfs:label "Elizabeth Line" .

