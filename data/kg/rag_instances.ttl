# Line Colours and Modes of Transport
lt:line_bakerloo lt:lineColour "#AE2069" ;
    lt:modeOfTransport lt:mode_tube .
lt:line_central lt:lineColour "#FF0033" ;
    lt:modeOfTransport lt:mode_tube .
lt:line_circle lt:lineColour "#FFC400" ;
    lt:modeOfTransport lt:mode_tube .
lt:line_district lt:lineColour "#007D42" ;
