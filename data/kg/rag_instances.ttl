    lt:modeOfTransport lt:mode_tube .
lt:line_waterloo-city lt:lineColour "#76D7F7" ;
    lt:modeOfTransport lt:mode_tube .
lt:line_elizabeth a lt:ElizabethLine ;
    lt:lineColour "#9F9F9F" ;
    lt:modeOfTransport lt:mode_elizabeth_line .
